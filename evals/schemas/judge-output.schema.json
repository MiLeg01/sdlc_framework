{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-commons/judge-output.schema.json",
  "title": "Independent semantic judge output",
  "type": "object",
  "required": ["assertions", "metrics"],
  "properties": {
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assertion", "status", "confidence", "reason", "evidence"],
        "properties": {
          "assertion": {"type": "string", "minLength": 1},
          "status": {"enum": ["PASS", "FAIL"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    },
    "unsupported_findings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "performance": {
      "type": "object",
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "duration_seconds": {"type": "number", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "judge_independence": {"enum": ["different_configured_models", "same_configured_model"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
